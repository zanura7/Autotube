AUTOTUBE_ENV=production
AUTOTUBE_SECRET_KEY=replace-with-a-fernet-key
AUTOTUBE_CORS_ORIGINS=https://autotube.example.com
AUTOTUBE_TIMEZONE=Asia/Jakarta
AUTOTUBE_DATA_DIR=/app/data
AUTOTUBE_MEDIA_ROOTS=/app/uploads:/app/generations
AUTOTUBE_JOBSTORE_URL=sqlite:////app/data/jobs.sqlite
FFMPEG_PATH=/usr/bin/ffmpeg
TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token
